# Dịch vụ AI (FastAPI). Chỉ Spring Boot gọi tới, trong mạng nội bộ.
AI_HOST=127.0.0.1
AI_PORT=8001
# Khóa dùng chung với backend (AI_SERVICE_KEY trong backend/.env). Để trống thì mọi /v1 trả 503.
AI_SERVICE_KEY=
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=20000
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# Không bao giờ đặt key trong frontend hoặc biến VITE_*.
