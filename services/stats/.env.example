# Dịch vụ thống kê (Django). Chỉ Spring Boot gọi tới, trong mạng nội bộ.
# Khóa dùng chung với backend (STATS_SERVICE_KEY trong backend/.env). Để trống thì mọi /v1 trả 503.
STATS_SERVICE_KEY=
# Bắt buộc đổi khi triển khai thật. Giá trị mặc định chỉ dùng trên máy phát triển.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
