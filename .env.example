# Cấu hình local: chép thành .env ở gốc repo nếu chưa có. Không commit bí mật.
# ===== Backend =====
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:5173
# none = không có reverse proxy (máy phát triển); native = đọc X-Forwarded-For từ proxy nội bộ.
FORWARD_HEADERS=none
# mock = dữ liệu tổng hợp trong bộ nhớ, không cần database; postgres = dùng PostgreSQL, Flyway tự chạy migration.
DATA_MODE=mock
SWAGGER_ENABLED=true
# Chỉ dùng cho Docker trên máy phát triển. Không dùng lại mật khẩu này trên server.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/health_assistant
DATABASE_USER=health_dev
DATABASE_PASSWORD=local_dev_only
# true = nạp database/seeds sau migration (chỉ máy phát triển).
SEED_SYNTHETIC=false
# true = nạp bài và chunk M7 (SCRUM-48) vào knowledge.* lúc khởi động; hai thư mục là đầu ra của
# bộ chuẩn hóa (chunks.jsonl, articles/) và của tools/translate (chunks_vi.jsonl, db_rows_vi.json).
KNOWLEDGE_INGEST_ENABLED=false
KNOWLEDGE_INGEST_NORMALIZED_DIR=
KNOWLEDGE_INGEST_TRANSLATED_DIR=
KNOWLEDGE_INGEST_REVIEW_DECISIONS=
KNOWLEDGE_INGEST_REVIEWER_ID=
# Ghi vào translation_model của chunk đã dịch (file dữ liệu không ghi model). Để trống thì NULL.
KNOWLEDGE_INGEST_TRANSLATION_MODEL=
# OAuth registration. Leave unused provider values empty.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Generate a private random secret of at least 32 bytes for access-token signing.
AUTH_TOKEN_SECRET=
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_KEY=
STATS_SERVICE_URL=http://127.0.0.1:8002
STATS_SERVICE_KEY=
# SMTP server used for email/password registration OTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=
# Generate a private random secret of at least 32 bytes; never commit a real value.
EMAIL_OTP_HASH_SECRET=
# Set to true to bootstrap an admin on startup; defaults to false.
ADMIN_BOOTSTRAP_ENABLED=false
# Required only when ADMIN_BOOTSTRAP_ENABLED=true; use a 12-72 byte password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Múi giờ của "hôm nay" khi ghi nhận thói quen (UC-13). Mặc định Asia/Ho_Chi_Minh.
LIFESTYLE_ZONE=Asia/Ho_Chi_Minh
# Số lộ trình đã kết thúc tối đa trả về ở GET /lifestyle/plans/history.
LIFESTYLE_HISTORY_LIMIT=100
# Nhắc nhở (UC-14) gửi qua SMTP_* và MAIL_FROM ở trên. false: chỉ dừng việc gửi, route vẫn chạy.
REMINDERS_ENABLED=true
# Khoảng giữa hai lần quét, khoảng trễ tối đa còn gửi (ISO-8601), số lần gửi tối đa, số nhắc mỗi người.
REMINDERS_POLL=PT1M
REMINDERS_WINDOW=PT10M
REMINDERS_MAX_ATTEMPTS=3
REMINDERS_MAX_PER_USER=20
# Dọn dữ liệu M6 mỗi ngày (cron theo LIFESTYLE_ZONE). Thời hạn ISO-8601: lần gửi đã gửi/bỏ qua, lần gửi lỗi/treo,
# completion của lộ trình đã kết thúc (tóm tắt rồi xóa), nhắc tạm tắt do đổi lộ trình. Nhắc tự tắt không bị xóa.
LIFESTYLE_RETENTION_ENABLED=true
LIFESTYLE_RETENTION_CRON=0 30 3 * * *
LIFESTYLE_RETENTION_SENT_DELIVERIES=P90D
LIFESTYLE_RETENTION_FAILED_DELIVERIES=P30D
LIFESTYLE_RETENTION_ENDED_PLAN_COMPLETIONS=P365D
LIFESTYLE_RETENTION_PAUSED_REMINDERS=P90D
LIFESTYLE_RETENTION_BATCH_SIZE=1000
# UC-19 thống kê hệ thống: ngày tính theo múi giờ này; không gửi khoảng thì lấy DEFAULT_DAYS ngày gần nhất.
# RECORD_EVENTS=false dừng ghi sự kiện đăng ký, truy cập, chat (SCRUM-51); xem thống kê vẫn chạy.
HEALTH_STATS_ZONE=Asia/Ho_Chi_Minh
HEALTH_STATS_DEFAULT_DAYS=30
HEALTH_STATS_MAX_DAYS=366
HEALTH_STATS_RECORD_EVENTS=true

# ===== Frontend =====
# Optional. Empty uses the Vite proxy during development.
# For a production build, set this to the deployed API origin (without a trailing slash).
VITE_API_ORIGIN=

# ===== AI =====
# Dịch vụ AI (FastAPI). Chỉ Spring Boot gọi tới, trong mạng nội bộ.
AI_HOST=127.0.0.1
AI_PORT=8001
AI_LLM_ENABLED=false
# Chatbox dùng router LLM local (OpenAI-compatible). Điền URL thật, không kèm /chat/completions.
# Windows: http://127.0.0.1:<port>/v1; AI trong Docker: http://host.docker.internal:<port>/v1.
AI_LLM_BASE_URL=
# Chỉ điền key riêng của router nếu router yêu cầu xác thực; không dùng key dịch.
AI_LLM_API_KEY=
AI_LLM_MODEL=
AI_LLM_TIMEOUT_MS=20000
# Điền URL/model trước khi bật AI_LLM_ENABLED=true. Không fallback sang provider khác.
# Không bao giờ đặt key trong frontend hoặc biến VITE_*.

# ===== Statistics =====
# Dịch vụ thống kê (Django). Chỉ Spring Boot gọi tới, trong mạng nội bộ.
# Bắt buộc đổi khi triển khai thật. Giá trị mặc định chỉ dùng trên máy phát triển.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# UC-19: khoảng ngày rộng nhất một yêu cầu thống kê hệ thống (giữ bằng HEALTH_STATS_MAX_DAYS của backend).
STATS_SYSTEM_MAX_DAYS=366
# UC-05: ngưỡng nhận xét xu hướng (không phải chẩn đoán). Nguồn tham chiếu: bảng trong README.md.
# Ngủ ít: dưới STATS_SLEEP_LOW_HOURS giờ ở ít nhất STATS_SLEEP_LOW_DAYS ngày trong STATS_SLEEP_WINDOW_DAYS ngày gần nhất.
STATS_SLEEP_LOW_HOURS=7
STATS_SLEEP_LOW_DAYS=5
STATS_SLEEP_WINDOW_DAYS=7
# Cân nặng đổi nhiều: chênh lệch đầu và cuối kỳ từ mức này trở lên (kg), theo tuần và theo tháng.
STATS_WEIGHT_CHANGE_KG_WEEK=2
STATS_WEIGHT_CHANGE_KG_MONTH=4

# ===== Translation (offline) =====
# Endpoint/model/key dịch riêng (6.1 sol); endpoint Internet phải dùng HTTPS.
TRANSLATE_LLM_BASE_URL=
TRANSLATE_LLM_MODEL=
TRANSLATE_LLM_API_KEY=
TRANSLATE_LLM_REASONING=low

# ===== Content review (offline) =====
# Không tự dùng key dịch hoặc key chatbox cho review.
REVIEW_LLM_BASE_URL=
REVIEW_LLM_MODEL=
REVIEW_LLM_API_KEY=
REVIEW_LLM_REASONING=medium
