# Chép thành deploy/.env rồi điền giá trị. File deploy/.env không được commit.
# Tạo chuỗi ngẫu nhiên: openssl rand -hex 32   (hoặc: python -c "import secrets; print(secrets.token_hex(32))")

# Tiền tố tên image do workflow CD đẩy lên: ghcr.io/<chủ repo, chữ thường>/se214-health
IMAGE_PREFIX=ghcr.io/luanlukim/se214-health
# Bản image: latest, hoặc mã commit đầy đủ trên main để cố định phiên bản và quay lại khi cần.
IMAGE_TAG=latest

# PostgreSQL. Đặt mật khẩu riêng, không dùng lại local_dev_only.
DATABASE_USER=health_app
DATABASE_PASSWORD=

# Địa chỉ frontend được phép gọi API (CORS), ví dụ https://demo.example.vn. Không có dấu / ở cuối.
WEB_ORIGIN=

# Khóa giữa backend và hai dịch vụ Python. Mỗi khóa một chuỗi ngẫu nhiên riêng.
AI_SERVICE_KEY=
STATS_SERVICE_KEY=
DJANGO_SECRET_KEY=

# Tài khoản (M5). Hai khóa dưới là chuỗi ngẫu nhiên riêng, ít nhất 32 byte (openssl rand -hex 32).
AUTH_TOKEN_SECRET=
EMAIL_OTP_HASH_SECRET=
TERMS_VERSION=v1
# Gửi mã OTP qua email. Để trống thì đăng ký/khôi phục bằng email trả 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Đăng nhập Google/Facebook. Để trống nhà cung cấp không dùng.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# true = công khai Swagger UI và /v3/api-docs. Bản triển khai nên để false.
SWAGGER_ENABLED=false

# Cổng backend trên máy chủ. Mặc định chỉ nghe ở 127.0.0.1 (đặt reverse proxy HTTPS phía trước).
# Demo trong mạng nội bộ không có proxy: BACKEND_BIND=0.0.0.0
BACKEND_BIND=127.0.0.1
BACKEND_PORT=4000
# Có reverse proxy phía trước: native (lấy IP người dùng từ X-Forwarded-For để giới hạn tần suất đúng).
# Không có proxy: none.
FORWARD_HEADERS=none

# production chặn nạp dữ liệu giả lập. Máy demo cần dữ liệu mẫu: APP_ENV=demo và SEED_SYNTHETIC=true.
APP_ENV=production
SEED_SYNTHETIC=false

# LLM (chỉ dịch vụ AI đọc). Để LLM_ENABLED=false cho tới khi M4 nối chat.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
