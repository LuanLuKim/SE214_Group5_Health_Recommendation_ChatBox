HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Local Docker development only. Never reuse this password on a server.
DATABASE_URL=postgresql://health_dev:local_dev_only@127.0.0.1:5432/health_assistant
# mock = tiny synthetic adapters, no database needed; postgres = query the seeded database.
DATA_MODE=mock
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=20000
# Gemini alternative: https://generativelanguage.googleapis.com/v1beta/openai
# Set the model ID yourself for the provider you choose. Never put secrets in VITE_ variables.
