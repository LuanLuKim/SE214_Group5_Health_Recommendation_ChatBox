# Optional. Empty uses the Vite proxy during development.
# For a production build, set this to the deployed API origin (without a trailing slash).
VITE_API_ORIGIN=

# UC-16: in `npm run dev`, the warning-rule screens use an in-browser synthetic mock while the
# /api/v1/safety/rules routes wait for M5 sessions. Set to false to call the real API instead.
# Production builds always use the real API.
VITE_SAFETY_RULES_MOCK=
