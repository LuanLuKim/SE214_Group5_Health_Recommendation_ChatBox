HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:5173
# none = không có reverse proxy (máy phát triển); native = đọc X-Forwarded-For từ proxy nội bộ.
FORWARD_HEADERS=none
# mock = dữ liệu tổng hợp trong bộ nhớ, không cần database; postgres = dùng PostgreSQL, Flyway tự chạy migration.
DATA_MODE=mock
SWAGGER_ENABLED=true
# Chỉ dùng cho Docker trên máy phát triển. Không dùng lại mật khẩu này trên server.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/health_assistant
DATABASE_USER=health_dev
DATABASE_PASSWORD=local_dev_only
# true = nạp database/seeds sau migration (chỉ máy phát triển).
SEED_SYNTHETIC=false
# true = nạp bài và chunk M7 (SCRUM-48) vào knowledge.* lúc khởi động; hai thư mục là đầu ra của
# bộ chuẩn hóa (chunks.jsonl, articles/) và của tools/translate (chunks_vi.jsonl, db_rows_vi.json).
KNOWLEDGE_INGEST_ENABLED=false
KNOWLEDGE_INGEST_NORMALIZED_DIR=
KNOWLEDGE_INGEST_TRANSLATED_DIR=
# OAuth registration. Leave unused provider values empty.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Generate a private random secret of at least 32 bytes for access-token signing.
AUTH_TOKEN_SECRET=
# Dịch vụ Python; khóa phải giống trong services/ai/.env và services/stats/.env.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_KEY=
STATS_SERVICE_URL=http://127.0.0.1:8002
STATS_SERVICE_KEY=
# SMTP server used for email/password registration OTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=
# Generate a private random secret of at least 32 bytes; never commit a real value.
EMAIL_OTP_HASH_SECRET=
# Set to true to bootstrap an admin on startup; defaults to false.
ADMIN_BOOTSTRAP_ENABLED=false
# Required only when ADMIN_BOOTSTRAP_ENABLED=true; use a 12-72 byte password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Múi giờ của "hôm nay" khi ghi nhận thói quen (UC-13). Mặc định Asia/Ho_Chi_Minh.
LIFESTYLE_ZONE=Asia/Ho_Chi_Minh
# Số lộ trình đã kết thúc tối đa trả về ở GET /lifestyle/plans/history.
LIFESTYLE_HISTORY_LIMIT=100
# Nhắc nhở (UC-14) gửi qua SMTP_* và MAIL_FROM ở trên. false: chỉ dừng việc gửi, route vẫn chạy.
REMINDERS_ENABLED=true
# Khoảng giữa hai lần quét, khoảng trễ tối đa còn gửi (ISO-8601), số lần gửi tối đa, số nhắc mỗi người.
REMINDERS_POLL=PT1M
REMINDERS_WINDOW=PT10M
REMINDERS_MAX_ATTEMPTS=3
REMINDERS_MAX_PER_USER=20
# Dọn dữ liệu M6 mỗi ngày (cron theo LIFESTYLE_ZONE). Thời hạn ISO-8601: lần gửi đã gửi/bỏ qua, lần gửi lỗi/treo,
# completion của lộ trình đã kết thúc (tóm tắt rồi xóa), nhắc tạm tắt do đổi lộ trình. Nhắc tự tắt không bị xóa.
LIFESTYLE_RETENTION_ENABLED=true
LIFESTYLE_RETENTION_CRON=0 30 3 * * *
LIFESTYLE_RETENTION_SENT_DELIVERIES=P90D
LIFESTYLE_RETENTION_FAILED_DELIVERIES=P30D
LIFESTYLE_RETENTION_ENDED_PLAN_COMPLETIONS=P365D
LIFESTYLE_RETENTION_PAUSED_REMINDERS=P90D
LIFESTYLE_RETENTION_BATCH_SIZE=1000
