HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:5173
# none = không có reverse proxy (máy phát triển); native = đọc X-Forwarded-For từ proxy nội bộ.
FORWARD_HEADERS=none
# mock = dữ liệu tổng hợp trong bộ nhớ, không cần database; postgres = dùng PostgreSQL, Flyway tự chạy migration.
DATA_MODE=mock
SWAGGER_ENABLED=true
# Chỉ dùng cho Docker trên máy phát triển. Không dùng lại mật khẩu này trên server.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/health_assistant
DATABASE_USER=health_dev
DATABASE_PASSWORD=local_dev_only
# true = nạp database/seeds sau migration (chỉ máy phát triển).
SEED_SYNTHETIC=false
# OAuth registration. Leave unused provider values empty.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Generate a private random secret of at least 32 bytes for access-token signing.
AUTH_TOKEN_SECRET=
# Dịch vụ Python; khóa phải giống trong services/ai/.env và services/stats/.env.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_KEY=
STATS_SERVICE_URL=http://127.0.0.1:8002
STATS_SERVICE_KEY=
# SMTP server used for email/password registration OTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=
# Generate a private random secret of at least 32 bytes; never commit a real value.
EMAIL_OTP_HASH_SECRET=
# Múi giờ của "hôm nay" khi ghi nhận thói quen (UC-13). Mặc định Asia/Ho_Chi_Minh.
LIFESTYLE_ZONE=Asia/Ho_Chi_Minh
