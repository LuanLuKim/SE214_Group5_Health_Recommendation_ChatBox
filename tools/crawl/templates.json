{
  "nhs": {
    "adapter": "nhs",
    "hosts": ["www.nhs.uk"],
    "templates": [
      {"id": "nhs-main-v1", "root": "main", "title": "h1", "remove": ["nav", "footer", "[class*=nhsuk-gallery]", "figure", "button", ".nhsuk-action-link", ".app-brightcove-video"]}
    ]
  },
  "who": {
    "adapter": "who",
    "hosts": ["www.who.int"],
    "templates": [
      {"id": "who-qa-v1", "root": ".qa-details__wrapper", "title": "h1", "remove": ["nav", "footer", ".sf-social-share", ".qa-details__title + span"], "headings": {".sf-accordion__trigger-panel": "h2"}},
      {"id": "who-topic-v1", "root": "article.health-topic--detail", "title": "h1", "remove": ["nav", "footer", ".sf-social-share", ".sf-header-title", "div.sf_colsIn:has(> p.section-header)"]}
    ]
  },
  "cdc": {"adapter": "generic", "hosts": ["www.cdc.gov"], "templates": []}
}
